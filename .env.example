# GEMINI_API_KEY (Opsional) - Diisi jika ingin mengaktifkan fitur AI Generatif (Gemini)
GEMINI_API_KEY=

# JWT_SECRET (Required) - Server-Side JWT Secret key for user sessions
JWT_SECRET=

# DATABASE_URL (Diperlukan untuk PostgreSQL/Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# USE_HTTPS (Opsional) - Diisi 'true' jika ingin memaksa mode HTTPS SSL
USE_HTTPS=false

# Kredensial Super Admin / BOS Platform (Opsional, bawaan: bos / bos123)
# Sangat direkomendasikan untuk diisi di server produksi demi keamanan
BOSS_USERNAME=
BOSS_PASSWORD=

# Kunci Enkripsi untuk local_store.json (Required)
LOCAL_STORE_SECRET=

# Kunci Garam Rahasia untuk Penguncian Token (Required)
TOKEN_LOCK_SECRET=

# Kunci Aktivasi Token Asimetris
# LICENSE_PRIVATE_KEY hanya boleh ada di server BOSS online. JANGAN salin ke instalasi madrasah.
# LICENSE_PUBLIC_KEY harus sama di BOSS dan instalasi admin offline; public key aman didistribusikan.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Cloudinary (Untuk backup foto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

